---
import { Image } from 'astro:assets';
import { projects, lab } from '../data/site';
---

<section id="realisations" class="wrap projects" aria-labelledby="realisations-title">
  <div class="section-head">
    <h2 id="realisations-title" class="h2">Des projets en ligne,<br /><span class="sf">pas des promesses.</span></h2>
    <p class="eyebrow">(03) Réalisations</p>
  </div>

  <div class="rows" data-rows>
    {
      projects.map((p) => {
        const Tag = p.href ? 'a' : 'div';
        const external = p.href?.startsWith('http');
        return (
          <Tag
            class="row"
            href={p.href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener' : undefined}
            data-preview={p.image ? p.name : undefined}
          >
            <span class="name">
              {p.name}
              {external && <span class="sr-only"> (nouvel onglet)</span>}
            </span>
            <span class="meta">
              <span>{p.kind}</span>
              <span class="pill">
                <span class="dot" style="width:6px;height:6px" />
                En ligne
              </span>
            </span>
          </Tag>
        );
      })
    }

    {
      projects
        .filter((p) => p.image)
        .map((p) => (
          <div class="preview" data-for={p.name} aria-hidden="true">
            <Image src={p.image!} alt="" width={340} height={260} widths={[340, 680]} sizes="340px" />
            <span class="see">Voir</span>
          </div>
        ))
    }
  </div>

  <div class="lab">
    <div class="lab-intro">
      <p class="eyebrow">Le labo</p>
      <p>Produits que je construis en ce moment, pour tester de nouvelles approches avant de les proposer à mes clients.</p>
    </div>
    <ul class="lab-list">
      {
        lab.map((l) => (
          <li>
            <span class="lab-name">{l.name}</span>
            <span class="lab-desc">{l.desc}</span>
            <span class="lab-status">{l.status}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .projects {
    padding-top: clamp(96px, 11vw, 150px);
    padding-bottom: clamp(96px, 11vw, 150px);
  }
  .rows {
    position: relative;
    border-top: 1px solid var(--ink);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    min-height: 120px;
    padding: 24px;
    border-bottom: 1px solid var(--line);
    transition:
      opacity 0.3s ease,
      transform 0.45s ease;
  }
  .rows.has-hover .row {
    opacity: 0.35;
  }
  .rows.has-hover .row.is-active {
    opacity: 1;
    transform: translateX(-16px);
  }
  .name {
    font-size: clamp(32px, 4.4vw, 64px);
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    font-size: 16px;
    color: var(--muted);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--pill);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .preview {
    position: absolute;
    left: 48%;
    top: 0;
    width: 340px;
    height: 260px;
    pointer-events: none;
    background: var(--ink);
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity 0.3s ease,
      transform 0.45s var(--ease);
    display: grid;
    place-items: center;
  }
  .preview.is-visible {
    opacity: 1;
    transform: scale(1);
  }
  .preview img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .see {
    position: relative;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--paper);
    display: grid;
    place-items: center;
    font-size: 15px;
  }
  @media (hover: none), (max-width: 900px) {
    .preview {
      display: none;
    }
  }

  .lab {
    margin-top: 96px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px 64px;
  }
  .lab-intro {
    flex: 1 1 260px;
  }
  .lab-intro .eyebrow {
    margin-bottom: 14px;
  }
  .lab-intro p:last-child {
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
  }
  .lab-list {
    flex: 999 1 560px;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .lab-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 24px;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
  }
  .lab-name {
    flex: 0 0 220px;
    font-size: 24px;
    letter-spacing: -0.02em;
  }
  .lab-desc {
    flex: 999 1 260px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
  }
  .lab-status {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .row {
      padding: 24px 0;
      min-height: 0;
    }
  }
</style>

<script>
  // Survol des réalisations : met en avant la ligne survolée et affiche sa capture.
  const rows = document.querySelector<HTMLElement>('[data-rows]');
  if (rows && matchMedia('(hover: hover)').matches) {
    const items = [...rows.querySelectorAll<HTMLElement>('.row')];
    const previews = [...rows.querySelectorAll<HTMLElement>('.preview')];

    const activate = (row: HTMLElement | null) => {
      rows.classList.toggle('has-hover', !!row);
      items.forEach((r) => r.classList.toggle('is-active', r === row));
      const name = row?.dataset.preview;
      previews.forEach((p) => {
        const on = !!name && p.dataset.for === name;
        p.classList.toggle('is-visible', on);
        if (on && row) p.style.top = `${row.offsetTop + row.offsetHeight / 2 - 130}px`;
      });
    };

    items.forEach((row) => {
      row.addEventListener('mouseenter', () => activate(row));
      row.addEventListener('focus', () => activate(row));
      row.addEventListener('blur', () => activate(null));
    });
    rows.addEventListener('mouseleave', () => activate(null));
  }
</script>
