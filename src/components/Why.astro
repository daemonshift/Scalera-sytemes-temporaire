---
import { strengths, tools } from '../data/site';
---

<section id="pourquoi" class="wrap why" aria-labelledby="pourquoi-title">
  <div class="section-head">
    <h2 id="pourquoi-title" class="h2">Ce que j’apporte<br /><span class="sf">à votre projet.</span></h2>
    <p class="eyebrow">(05) Pourquoi moi</p>
  </div>
  <div class="grid">
    {
      strengths.map((s) => (
        <div class="item">
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))
    }
  </div>
  <div class="tools">
    <span class="label">Outils</span>
    <span>{tools.join(' · ')}</span>
  </div>
</section>

<style>
  .why {
    padding-top: clamp(96px, 11vw, 150px);
    padding-bottom: 120px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 0 64px;
    border-top: 1px solid var(--ink);
  }
  .item {
    padding: 40px 0;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h3 {
    font-size: clamp(30px, 3vw, 44px);
    font-weight: 400;
    letter-spacing: -0.03em;
  }
  p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
  }
  .tools {
    margin-top: 56px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 28px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }
  .label {
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
